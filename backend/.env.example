# Copy this file to .env and add your own values.
APP_NAME=KhetSathi AI
ENVIRONMENT=development
DATABASE_URL=sqlite:///./khetsathi.db
FRONTEND_ORIGIN=http://localhost:5173

# Optional: Microsoft Agent Framework + Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash-lite

# Optional: data.gov.in / AGMARKNET integration
DATA_GOV_API_KEY=
AGMARKNET_RESOURCE_ID=

# Weather API is keyless. Set DEMO_MODE=false to disable illustrative fallback data.
DEMO_MODE=true
CHROMA_PATH=./.chroma
SCHEME_DATA_PATH=./data/schemes
